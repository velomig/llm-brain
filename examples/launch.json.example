{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "neural-map",
      "runtimeExecutable": "/path/to/LLM Brain/.venv/bin/python",
      "runtimeArgs": [
        "-m", "uvicorn", "server:app",
        "--app-dir", "/path/to/LLM Brain",
        "--host", "127.0.0.1", "--port", "8000", "--log-level", "warning",
        "--reload",
        "--reload-dir", "/path/to/LLM Brain",
        "--reload-exclude", "*/.venv/*",
        "--reload-exclude", "*/memory_store/*"
      ],
      "port": 8000
    }
  ]
}
