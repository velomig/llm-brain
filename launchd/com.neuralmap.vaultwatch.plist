<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.neuralmap.vaultwatch</string>
	<key>ProgramArguments</key>
	<array>
		<string>$HOME/Documents/LLM Brain/.venv/bin/python</string>
		<string>$HOME/Documents/LLM Brain/ingest_md.py</string>
		<string>$HOME/Documents/Obsidian Vault</string>
		<string>--watch</string>
		<string>--interval</string>
		<string>60</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>$HOME/Documents/LLM Brain</string>
	<key>StandardOutPath</key>
	<string>$HOME/Library/Logs/neuralmap/vaultwatch.out.log</string>
	<key>StandardErrorPath</key>
	<string>$HOME/Library/Logs/neuralmap/vaultwatch.err.log</string>
</dict>
</plist>
